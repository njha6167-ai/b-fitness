# ============================================================
# B-FITNESS BACKEND — ENVIRONMENT VARIABLES
# Copy this file to ".env" in the same folder and fill in the values.
# Never commit the real ".env" file to git.
# ============================================================

# --- Server ---
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/bfitness
# Or MongoDB Atlas (recommended for production), example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bfitness

# --- Gym info (used inside WhatsApp message templates) ---
GYM_NAME=B-FITNESS

# ============================================================
# WHATSAPP BUSINESS CLOUD API CREDENTIALS
# ============================================================
# 1. Go to https://developers.facebook.com/apps and create/select an app.
# 2. Add the "WhatsApp" product to the app.
# 3. Under WhatsApp > API Setup you will find:
#      - A temporary/permanent ACCESS TOKEN
#      - A PHONE NUMBER ID
#      - A WHATSAPP BUSINESS ACCOUNT ID
# 4. Paste those values below. That's it — the backend
#    (services/whatsappService.js) will pick them up automatically.
#
# If you leave these blank, the app keeps working normally —
# the "Send WhatsApp" button will fall back to opening a
# wa.me link with the message pre-filled instead of sending
# it automatically. See services/whatsappService.js for the
# exact logic that decides which path is used.
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Graph API version (change only if Meta deprecates this version)
WHATSAPP_API_VERSION=v20.0

# --- Reminder scheduler ---
# Cron expression for the daily reminder check. Default = every day at 09:00 server time.
REMINDER_CRON=0 9 * * *
